# PostgreSQL (docker compose)
POSTGRES_USER=liveboard
POSTGRES_PASSWORD=liveboard
POSTGRES_DB=liveboard
# 로컬 PostgreSQL과 충돌하지 않도록 5433 사용
POSTGRES_PORT=5433

DATABASE_URL=postgres://liveboard:liveboard@127.0.0.1:5433/liveboard

# Server
SERVER_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Web (Vite)
VITE_SERVER_URL=http://localhost:4000
VITE_BOARD_ID=00000000-0000-4000-8000-000000000001
