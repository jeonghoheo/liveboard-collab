{
  "name": "liveboard-collab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:server": "npm run dev -w @liveboard/server",
    "dev:web": "npm run dev -w @liveboard/web",
    "migrate": "npm run migrate -w @liveboard/server",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker compose exec postgres psql -U liveboard -d liveboard"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
